<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ShuyahStore Android : le site ShuyahStore dans une application, avec ce qu'un site ne peut pas faire :
         installer et mettre à jour une application, savoir ce qui est installé, compter installations et désinstallations. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installer les applications téléchargées (l'utilisateur confirme chaque installation dans la fenêtre d'Android) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Proposer la désinstallation (Android demande toujours confirmation) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Savoir quelles applications du catalogue sont installées, et dans quelle version (comparaison faite SUR le téléphone, rien n'est envoyé) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Verrou de l'application par empreinte -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ShuyahStore">
        <!-- Une seule fenêtre. singleTop : le résultat d'une installation revient à CETTE fenêtre (onNewIntent). configChanges : la rotation ne recharge pas la page -->
        <activity
            android:name=".WebActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
